type User {
    id: ID!
    username: String!
    email: String!
    createdAt: Int
    updatedAt: Int
    posts: [Post]
}

type Post {
    id: ID!
    title: String!
    content: String!
    published: Boolean!
    author: User
    reviews: [Review]
    createdAt: Int
    updatedAt: Int
}

type Comment {
    id: ID!
    content: String!
    user: User
    post: Post
    createdAt: Int
    updatedAt: Int
}

type Review {
    id: ID!
    rating: Int!
    feedback: String
    user: User
    post: Post
    createdAt: Int
    updatedAt: Int
}

type Tag {
    id: ID!
    name: String!
}

# ---------------------
# Queries
# ---------------------
type Query {
    users: [User]
    posts: [Post]
    comments: [Comment]
    reviews: [Review]
    tags: [Tag]
    postById(id: ID!): Post
}

# ---------------------
# Mutations
# ---------------------
type Mutation {
    createPost(input: PostInput): Post
    addComment(input: CommentInput): Comment
    addReview(input: ReviewInput): Review
}

# ---------------------
# Input Types
# ---------------------
input PostInput {
    authorId: ID!
    title: String!
    content: String!
}

input CommentInput {
    postId: ID!
    userId: ID!
    content: String!
}

input ReviewInput {
    postId: ID!
    userId: ID!
    rating: Int!
    feedback: String
}
